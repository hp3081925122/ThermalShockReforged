      "network_actions": "public static void handleButtonAction(Player entity, int buttonID, int x, int y, int z) {\n        Level world = entity.level();\n        HashMap<String, Object> guistate = BenzorInfoMenu.guistate;\n        if (!world.hasChunkAt(new BlockPos(x, y, z))) {\n            return;\n        }\n        if (buttonID == 0) {\n            BenzorSelfPageOpenProcedure.execute((LevelAccessor)world, x, y, z, (Entity)entity);\n        }\n        if (buttonID == 1) {\n            BenzorSpiceInfoPageOpenProcedure.execute((LevelAccessor)world, x, y, z, (Entity)entity);\n        }\n        if (buttonID == 2) {\n            BenzorInfectionPageOpenProcedure.execute((LevelAccessor)world, x, y, z, (Entity)entity);\n        }\n        if (buttonID == 3) {\n            BenzorBlizzardPageOpenProcedure.execute((LevelAccessor)world, x, y, z, (Entity)entity);\n        }\n        if (buttonID == 4) {\n            BenzorBlackpowderPageOpenProcedure.execute((LevelAccessor)world, x, y, z, (Entity)entity);\n        }\n    }\n\n",
